{
  "name": "@idangoldman/plate",
  "title": "PLATE",
  "description": "A simple boilerplate for web development",
  "author": "Idan Goldman",
  "license": "MIT",
  "version": "0.10.0",
  "homepage": "https://github.com/idangoldman/plate/",
  "repository": {
    "type": "git",
    "url": "https://github.com/idangoldman/plate.git"
  },
  "bugs": {
    "url": "https://github.com/idangoldman/plate/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    "./library/*": "./src/library/**/*.js"
  },
  "files": [
    "library",
    "src"
  ],
  "devDependencies": {
    "@cucumber/cucumber": "12.2.0",
    "@cucumber/pretty-formatter": "2.4.1",
    "@types/node": "^26.1.2",
    "chai": "4.5.0",
    "prettier": "3.7.1",
    "prettier-plugin-gherkin": "3.1.3",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.9.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "NODE_OPTIONS=\"--import tsx\" cucumber-js -c configs/cucumber.yml",
    "build": "tsc && tsc-alias"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "main": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts"
}
