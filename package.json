{
  "name": "@idangoldman/plate",
  "title": "PLATE",
  "description": "A simple boilerplate for web development",
  "author": "Idan Goldman",
  "license": "MIT",
  "version": "0.10.0",
  "homepage": "https://github.com/idangoldman/plate/",
  "repository": {
    "type": "git",
    "url": "https://github.com/idangoldman/plate.git"
  },
  "bugs": {
    "url": "https://github.com/idangoldman/plate/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "plate": "./bin/plate.js"
  },
  "imports": {
    "#root/*": "./src/*"
  },
  "files": [
    "bin",
    "configs",
    "library",
    "tasks",
    "src"
  ],
  "scripts": {
    "help": "plate help",
    "build-binaries": "TASK_TEMP_DIR=../tmp/task task --taskfile ./tasks/Taskfile.yml binaries:build"
  },
  "dependencies": {
    "@idangoldman/plate": "link:"
  },
  "devDependencies": {
    "@coffeelint/cli": "5.2.11",
    "@cucumber/cucumber": "12.2.0",
    "@cucumber/pretty-formatter": "2.3.0",
    "chai": "6.2.0",
    "coffeescript": "2.7.0",
    "esbuild": "0.25.10",
    "esbuild-coffeescript": "3.0.1",
    "globals": "16.4.0",
    "lodash": "4.17.21",
    "prettier": "3.6.2",
    "prettier-plugin-gherkin": "3.1.2",
    "yaml": "2.8.1"
  }
}
