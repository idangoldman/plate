{
  "name": "@idangoldman/plate",
  "title": "PLATE",
  "description": "A simple boilerplate for web development",
  "author": "Idan Goldman",
  "license": "MIT",
  "version": "0.7.0",
  "homepage": "https://github.com/idangoldman/plate/",
  "repository": {
    "type": "git",
    "url": "https://github.com/idangoldman/plate.git"
  },
  "bugs": {
    "url": "https://github.com/idangoldman/plate/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "plate": "./bin/plate.fish"
  },
  "imports": {
    "#root/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    "./plugins/*": "./src/plugins/*"
  },
  "files": [
    "bin",
    "configs",
    "lib",
    "processes",
    "src"
  ],
  "scripts": {
    "help": "plate help",
    "build:lib": "coffee --bare --compile --no-header --output src lib",
    "build:tests": "coffee --bare --compile --no-header --output src/tests tests",
    "build": "npm run build:lib && npm run build:tests",
    "test:run": "cucumber-js --config=configs/cucumber.yml",
    "test": "npm run build && npm run test:run",
    "lint:prettier": "prettier --check --config configs/prettierrc.yml --ignore-path configs/.prettierignore \"{lib,tests}/**/*.coffee\"",
    "lint:coffeelint": "coffeelint --file configs/coffeelint.yml lib tests",
    "lint": "npm run lint:prettier && npm run lint:coffeelint",
    "format:prettier": "prettier --write --config configs/prettierrc.yml --ignore-path configs/.prettierignore \"{lib,tests}/**/*.coffee\""
  },
  "dependencies": {
    "@coffeelint/cli": "5.2.11",
    "@cucumber/cucumber": "11.2.0",
    "@cucumber/pretty-formatter": "1.0.1",
    "chai": "5.2.0",
    "coffeescript": "2.7.0",
    "esbuild": "0.25.4",
    "globals": "16.1.0",
    "lodash": "4.17.21",
    "prettier": "3.5.3",
    "yaml": "2.7.1"
  }
}
