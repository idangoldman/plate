{
  "name": "@idangoldman/plate",
  "title": "PLATE",
  "description": "A simple boilerplate for web development",
  "author": "Idan Goldman",
  "license": "MIT",
  "version": "0.10.0",
  "homepage": "https://github.com/idangoldman/plate/",
  "repository": {
    "type": "git",
    "url": "https://github.com/idangoldman/plate.git"
  },
  "bugs": {
    "url": "https://github.com/idangoldman/plate/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    "./library/*": "./src/library/**/*.js",
    "./dom": "./dist/library/dom/index.js",
    "./stores": "./dist/library/stores/index.js"
  },
  "files": [
    "library",
    "src"
  ],
  "devDependencies": {
    "@cucumber/cucumber": "13.2.0",
    "@cucumber/pretty-formatter": "4.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "26.1.2",
    "chai": "6.2.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-gherkin": "4.0.0",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.1",
    "tslib": "2.8.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "test": "NODE_OPTIONS=\"--import tsx\" cucumber-js -c configs/cucumber.yml",
    "build": "tsc && tsc-alias"
  },
  "main": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts"
}
