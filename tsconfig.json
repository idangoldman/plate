{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext", // 👈 Update this
    "moduleResolution": "NodeNext", // 👈 Update this
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": ["./*"]
    },
    "declaration": true
  },
  "include": ["library/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
